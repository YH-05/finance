  <in-bse-shp:NumberOfVotingRights contextRef="I01I">6000000</in-bse-shp:NumberOfVotingRights>
  <in-bse-shp:ShareholdingAsAPercentageOfTotalNumberOfShares contextRef="I01I">6.00</in-bse-shp:ShareholdingAsAPercentageOfTotalNumberOfShares>
  <in-bse-shp:NumberOfEquitySharesHeldInDematerializedForm contextRef="I01I">6000000</in-bse-shp:NumberOfEquitySharesHeldInDematerializedForm>

