  <in-bse-shp:ShareholdingAsAPercentageOfTotalNumberOfShares contextRef="B02I">55.00</in-bse-shp:ShareholdingAsAPercentageOfTotalNumberOfShares>
  <in-bse-shp:ShareholdingAsAPercentageAssumingFullConversionOfConvertibleSecuritiesAndWarrants contextRef="B02I">55.00</in-bse-shp:ShareholdingAsAPercentageAssumingFullConversionOfConvertibleSecuritiesAndWarrants>
  <in-bse-shp:NumberOfEquitySharesHeldInDematerializedForm contextRef="B02I">55000000</in-bse-shp:NumberOfEquitySharesHeldInDematerializedForm>

  <!-- Mutual Funds sub-category: 10,000,000 shares = 10.00% -->
  <in-bse-shp:NumberOfShareholders contextRef="B03I">15</in-bse-shp:NumberOfShareholders>
  <in-bse-shp:NumberOfFullyPaidUpEquityShares contextRef="B03I">10000000</in-bse-shp:NumberOfFullyPaidUpEquityShares>
  <in-bse-shp:NumberOfVotingRights contextRef="B03I">10000000</in-bse-shp:NumberOfVotingRights>
  <in-bse-shp:ShareholdingAsAPercentageOfTotalNumberOfShares contextRef="B03I">10.00</in-bse-shp:ShareholdingAsAPercentageOfTotalNumberOfShares>
  <in-bse-shp:ShareholdingAsAPercentageAssumingFullConversionOfConvertibleSecuritiesAndWarrants contextRef="B03I">10.00</in-bse-shp:ShareholdingAsAPercentageAssumingFullConversionOfConvertibleSecuritiesAndWarrants>
  <in-bse-shp:NumberOfEquitySharesHeldInDematerializedForm contextRef="B03I">10000000</in-bse-shp:NumberOfEquitySharesHeldInDematerializedForm>

  <!-- ==================== Detail-level data ==================== -->

  <!-- Mutual fund #1 (duration: name + PAN) -->
  <in-bse-shp:NameOfTheShareholder contextRef="I01D">Sample Mutual Fund Scheme A</in-bse-shp:NameOfTheShareholder>
  <in-bse-shp:PermanentAccountNumberOfShareholder contextRef="I01D">AAAMT1234A</in-bse-shp:PermanentAccountNumberOfShareholder>

  <!-- Mutual fund #1 (instant: numeric) -->
