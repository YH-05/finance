<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
FRED 日次同期
=============
毎日 06:00 に FRED データを同期する。
stale-hours 24 で前日データが古い場合に再取得する。

インストール:
  $ cp scripts/com.quants.fred-sync.plist ~/Library/LaunchAgents/
  $ launchctl load ~/Library/LaunchAgents/com.quants.fred-sync.plist

手動実行: $ launchctl start com.quants.fred-sync
ログ:     $ tail -f ~/Library/Logs/quants/fred-sync.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quants.fred-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/yuki/.local/bin/uv</string>
        <string>run</string>
        <string>--env-file</string>
        <string>/Users/yuki/Desktop/quants/.env</string>
        <string>python</string>
        <string>-u</string>
        <string>-m</string>
        <string>market.fred.scripts.sync_historical</string>
        <string>--auto</string>
        <string>--stale-hours</string>
        <string>24</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/yuki/Desktop/quants</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/yuki/Library/Logs/quants/fred-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yuki/Library/Logs/quants/fred-sync-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/yuki/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
