<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Phase 1: NASDAQ Earnings Calendar 取得
========================================
毎日 1:00 に決算カレンダーを取得し CollectionQueue に銘柄を登録する。
priority は決算日の近さ（近い = 高い）に基づいて自動設定される。

インストール:
  $ cp scripts/com.quants.pipeline-nasdaq.plist ~/Library/LaunchAgents/
  $ launchctl load ~/Library/LaunchAgents/com.quants.pipeline-nasdaq.plist

手動実行: $ launchctl start com.quants.pipeline-nasdaq
ログ:     $ tail -f ~/Library/Logs/quants/pipeline-nasdaq.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quants.pipeline-nasdaq</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/yuki/.local/bin/uv</string>
        <string>run</string>
        <string>--env-file</string>
        <string>/Users/yuki/Desktop/quants/.env</string>
        <string>python</string>
        <string>-u</string>
        <string>-m</string>
        <string>market.pipeline</string>
        <string>--phase</string>
        <string>1</string>
        <string>--days-back</string>
        <string>7</string>
        <string>--days-forward</string>
        <string>14</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/yuki/Desktop/quants</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>1</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/yuki/Library/Logs/quants/pipeline-nasdaq.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yuki/Library/Logs/quants/pipeline-nasdaq-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/yuki/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
