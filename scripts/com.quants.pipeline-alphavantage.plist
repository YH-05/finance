<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Phase 2: AlphaVantage EPS + Company Overview 収集
==================================================
毎日 2:00 にキューから決算日が近い順に AV データを取得する。
free tier: 25 コール/日（av_earnings 12 + av_overview 12）。

インストール:
  $ cp scripts/com.quants.pipeline-alphavantage.plist ~/Library/LaunchAgents/
  $ launchctl load ~/Library/LaunchAgents/com.quants.pipeline-alphavantage.plist

手動実行: $ launchctl start com.quants.pipeline-alphavantage
ログ:     $ tail -f ~/Library/Logs/quants/pipeline-alphavantage.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quants.pipeline-alphavantage</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/yuki/.local/bin/uv</string>
        <string>run</string>
        <string>--env-file</string>
        <string>/Users/yuki/Desktop/quants/.env</string>
        <string>python</string>
        <string>-u</string>
        <string>-m</string>
        <string>market.pipeline</string>
        <string>--phase</string>
        <string>2</string>
        <string>--av-budget</string>
        <string>25</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/yuki/Desktop/quants</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/yuki/Library/Logs/quants/pipeline-alphavantage.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yuki/Library/Logs/quants/pipeline-alphavantage-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/yuki/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
