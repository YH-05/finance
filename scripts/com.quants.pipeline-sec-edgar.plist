<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Phase 3: SEC EDGAR 財務諸表収集
================================
毎日 2:00 にキューから pending の銘柄の 10-K/10-Q を取得する。
AV/yfinance とは独立して並列実行される。

インストール:
  $ cp scripts/com.quants.pipeline-sec-edgar.plist ~/Library/LaunchAgents/
  $ launchctl load ~/Library/LaunchAgents/com.quants.pipeline-sec-edgar.plist

手動実行: $ launchctl start com.quants.pipeline-sec-edgar
ログ:     $ tail -f ~/Library/Logs/quants/pipeline-sec-edgar.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quants.pipeline-sec-edgar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/yuki/.local/bin/uv</string>
        <string>run</string>
        <string>--env-file</string>
        <string>/Users/yuki/Desktop/quants/.env</string>
        <string>python</string>
        <string>-u</string>
        <string>-m</string>
        <string>market.pipeline</string>
        <string>--phase</string>
        <string>3</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/yuki/Desktop/quants</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/yuki/Library/Logs/quants/pipeline-sec-edgar.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yuki/Library/Logs/quants/pipeline-sec-edgar-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/yuki/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
