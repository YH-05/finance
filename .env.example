# quants - Environment Variables Configuration
#
# 使い方:
#   cp .env.example .env
#   # 各値を設定したうえで、NAS へ退避する場合は /sync-nas --push
#
# 値の入手元は docs/MIGRATION.md「秘密情報の再設定」を参照。
# 本ファイルには値を書かないこと（.env のみが値を持ち、.gitignore 対象）。

# =============================================================================
# 必須: パス設定
# =============================================================================

# データルート。NAS 上の実データを直接参照する（20GB、正本）
# 例: /Volumes/personal_folder/Projects/quants/data
# 注意: リポジトリ内 data/ 配下の 8 つのシンボリックリンクは
#       /Volumes/personal_folder/data/ という「別の古い場所」を指している。
#       正本はこの DATA_DIR。詳細は docs/MIGRATION.md「NAS のデータ二重化」参照。
DATA_DIR=

# ローカルキャッシュ置き場（リポジトリ内 data/ を指す）
# 例: /path/to/quants/data
CACHE_DIR=

# リサーチ出力ルート（リポジトリからの相対パス）
# 既定: research/
RESEARCH_DIR=research/

# FRED 履歴データのキャッシュ先
# 例: ${DATA_DIR}/raw/fred/indicators
FRED_HISTORICAL_CACHE_DIR=

# =============================================================================
# 必須: 外部 API キー
# =============================================================================

# FRED API (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# FRASER REST API (https://fraser.stlouisfed.org/api - POST /api/api_key で発行)
FRASER_API_KEY=

# Alpha Vantage (https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=

# EDINET (金融庁 EDINET API v2)
EDINET_DB_API_KEY=

# Tavily 検索 API (.mcp.json の tavily サーバーも同じ値を参照)
TAVILY_API_KEY=

# Notion API (.mcp.json の notion サーバーが参照)
NOTION_API_KEY=

# LlamaCloud (embedding / ドキュメントパース)
LLAMA_CLOUD_API_KEY=

# =============================================================================
# 必須: SEC EDGAR 識別子
# =============================================================================
# SEC は User-Agent に連絡先メールアドレスを要求する
# 形式: "Name email@example.com"
# 2 変数は同じ値でよい（参照するライブラリが異なる）
EDGAR_IDENTITY=
SEC_EDGAR_IDENTITY=

# =============================================================================
# 必須: Neo4j 接続
# =============================================================================
# ローカル Docker コンテナ (docker-compose.yml の neo4j サービス)
# 起動: bash scripts/start-neo4j.sh
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=
NEO4J_QUANTS_DB=quants

# =============================================================================
# ロギング / 実行環境
# =============================================================================
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# LOG_FORMAT: json | text | console
LOG_FORMAT=console
# PROJECT_ENV: development | production
PROJECT_ENV=development

# =============================================================================
# 任意
# =============================================================================

# FRED series 設定ファイル (URL またはローカルパス)
# 既定: ./data/config/fred_series.json
# FRED_SERIES_ID_JSON=

# .env の探索パスを固定したい場合
# 既定: カレント〜親ディレクトリを探索
# DOTENV_PATH=

# =============================================================================
# ここに書かないもの
# =============================================================================
# ANTHROPIC_API_KEY : Claude Code が自身の認証を持つため不要
# GH_TOKEN          : `gh auth login` (keyring) を使うため不要
#                     CI など keyring が使えない環境でのみ設定する
# SLACK_BOT_TOKEN   : .mcp.json の slack サーバー用（必要な場合のみ）
